<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zomato Clone</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Navigation Bar -->
    <nav>
        <div class="nav-container">
            <span class="get-app">Get the App</span>
            <ul class="nav-links">
                <li><a href="#">Investor Relations</a></li>
                <li><a href="#">Add restaurant</a></li>
                <li><a href="#">Log in</a></li>
                <li><a href="#">Sign up</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero">
        <div class="hero-content">
            <img src="https://zmtcdn.com" alt="Zomato Logo" class="logo">
            <h1>Discover the best food & drinks in your city</h1>
            <div class="search-container">
                <input type="text" placeholder="Search for restaurant, cuisine or a dish" class="search-bar">
            </div>
        </div>
    </header>

    <!-- Categories Section -->
    <section class="categories">
        <div class="card">
            <img src="order_online.jpg" alt="Order Online">
            <h3>Order Online</h3>
            <p>Stay home and order to your doorstep</p>
        </div>
        <div class="card">
            <img src="dining.jpg" alt="Dining">
            <h3>Dining</h3>
            <p>View the city's favourite dining venues</p>
        </div>
    </section>
</body>
</html>

